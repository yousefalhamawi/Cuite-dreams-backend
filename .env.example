NODE_ENV=development
PORT=4000

# Supabase Postgres connection string (Transaction or Session pooler)
# Example: postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.gbeuzxgtwaiywtcpmwre:cutie@2026CDreamsLL11@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
# JWT — separate secrets / audiences for admin vs customer
JWT_ADMIN_SECRET=change-me-admin-secret-min-32-chars!!
JWT_CUSTOMER_SECRET=change-me-customer-secret-min-32-chars!
JWT_ADMIN_AUDIENCE=cutie-baby-admin
JWT_CUSTOMER_AUDIENCE=cutie-baby-customer
JWT_ISSUER=cutie-baby-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Rate limits (in-memory; fine for single instance — no Redis)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_PUBLIC=300
RATE_LIMIT_MAX_AUTH=20
RATE_LIMIT_MAX_WRITE=60

# Seed admin (used by npm run seed:admin)
ADMIN_EMAIL=admin@cutiebaby.local
ADMIN_PASSWORD=ChangeMeStrongPass123!
ADMIN_NAME=Store Admin

# Cloudflare R2 — photo + receipt uploads (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cutie-baby-uploads
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
R2_MAX_FILE_SIZE_MB=5

# Resend — password-reset OTP emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cutie Dreams <noreply@cutiedreams.com>
